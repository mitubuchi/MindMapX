<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>MindMap.Desktop</RootNamespace>
    <AssemblyName>MindMap</AssemblyName>
    <Product>MindMap</Product>
    <Company>MindMap</Company>
    <Version>0.1.0</Version>
    <Copyright>Copyright © 2026</Copyright>

    <!-- Windows 以外では単に無視される。 -->
    <ApplicationIcon>..\MindMap.App\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <!--
      描画系の版はホストが決める。plugins のパッケージは Avalonia と SkiaSharp を
      ホストのものに寄せて動く（PackageLoadContext）ので、ここが古いとパッケージ側で
      足りないメソッドが出る。MdViewer の SVG 描画（Svg.Skia）が SkiaSharp 3.116.1 を要るので、
      Avalonia の既定（2.88.9）から上げておく。Avalonia 11.3 は SkiaSharp 3 で動く。
      Linux のネイティブ部品は本体から辿られないので、版を揃えて明示する。
    -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MindMap.App\MindMap.App.csproj" />
  </ItemGroup>

</Project>
