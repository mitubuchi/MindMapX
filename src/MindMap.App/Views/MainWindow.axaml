<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:MindMap.Converters"
        xmlns:res="using:MindMap.Resources"
        xmlns:vm="using:MindMap.ViewModels"
        xmlns:views="using:MindMap.Views"
        x:Class="MindMap.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://MindMap.App/Assets/app.ico"
        Width="1280"
        Height="760"
        FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseActiveDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding ActiveDocument.SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding ActiveDocument.SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding ActiveDocument.UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding ActiveDocument.RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding ActiveDocument.RedoCommand}" />
        <!-- 編集中はコマンドが無効になるので、キーはそのままテキストボックスに届く -->
        <KeyBinding Gesture="Ctrl+X" Command="{Binding ActiveDocument.CutCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding ActiveDocument.CopyCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding ActiveDocument.PasteCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding ActiveDocument.SelectAllCommand}" />
        <!-- 編集中はノードの構造を変えるコマンドが無効になるので、キーはそのまま入力欄に届く
             （Tab は欄の移動、Enter は改行、Delete は文字の削除になる）。 -->
        <KeyBinding Gesture="Tab" Command="{Binding ActiveDocument.AddChildCommand}" />
        <KeyBinding Gesture="Insert" Command="{Binding ActiveDocument.AddChildCommand}" />
        <KeyBinding Gesture="Enter" Command="{Binding ActiveDocument.AddSiblingCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding ActiveDocument.DeleteNodeCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding ActiveDocument.BeginEditCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ActiveDocument.ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ActiveDocument.ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ActiveDocument.ResetZoomCommand}" />
        <KeyBinding Gesture="F7" Command="{Binding Viewer.ToggleCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!--
            ツールバー。ボタンはアイコンだけを並べ、名称とショートカットは
            マウスを乗せたときにツールチップで出す（並びがずれないため）。
        -->
        <Border DockPanel.Dock="Top"
                Background="#FAFBFC"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="1">
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding NewDocumentCommand}"
                        Tag="{x:Static res:Icons.New}"
                        ToolTip.Tip="新規 (Ctrl+N)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding OpenDocumentCommand}"
                        Tag="{x:Static res:Icons.Open}"
                        ToolTip.Tip="開く (Ctrl+O)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.SaveCommand}"
                        Tag="{x:Static res:Icons.Save}"
                        ToolTip.Tip="保存 (Ctrl+S)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.SaveAsCommand}"
                        Tag="{x:Static res:Icons.SaveAs}"
                        ToolTip.Tip="名前を付けて保存 (Ctrl+Shift+S)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding SaveAllCommand}"
                        Tag="{x:Static res:Icons.SaveAll}"
                        ToolTip.Tip="すべて保存 (Ctrl+Alt+S)" />

                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />

                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.UndoCommand}"
                        Tag="{x:Static res:Icons.Undo}"
                        ToolTip.Tip="元に戻す (Ctrl+Z)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.RedoCommand}"
                        Tag="{x:Static res:Icons.Redo}"
                        ToolTip.Tip="やり直し (Ctrl+Y)" />

                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />

                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.CutCommand}"
                        Tag="{x:Static res:Icons.Cut}"
                        ToolTip.Tip="切り取り (Ctrl+X)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.CopyCommand}"
                        Tag="{x:Static res:Icons.Copy}"
                        ToolTip.Tip="コピー (Ctrl+C)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.PasteCommand}"
                        Tag="{x:Static res:Icons.Paste}"
                        ToolTip.Tip="貼り付け (Ctrl+V)" />

                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />

                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.AddChildCommand}"
                        Tag="{x:Static res:Icons.AddChild}"
                        ToolTip.Tip="子ノード (Tab)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.AddSiblingCommand}"
                        Tag="{x:Static res:Icons.AddSibling}"
                        ToolTip.Tip="兄弟ノード (Enter)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.BeginEditCommand}"
                        Tag="{x:Static res:Icons.Edit}"
                        ToolTip.Tip="編集 (F2)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.DeleteNodeCommand}"
                        Tag="{x:Static res:Icons.Delete}"
                        ToolTip.Tip="削除 (Delete)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ArrangeChildrenVerticalCommand}"
                        Tag="{x:Static res:Icons.ArrangeVertical}"
                        ToolTip.Tip="子ノードを縦に整列（本文と孫は隠す）" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ArrangeChildrenHorizontalCommand}"
                        Tag="{x:Static res:Icons.ArrangeHorizontal}"
                        ToolTip.Tip="子ノードを横に整列（本文と孫は隠す）" />

                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />

                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ZoomOutCommand}"
                        Tag="{x:Static res:Icons.ZoomOut}"
                        ToolTip.Tip="縮小 (Ctrl+-)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ResetZoomCommand}"
                        Tag="{x:Static res:Icons.ZoomReset}"
                        ToolTip.Tip="等倍に戻す (Ctrl+0)" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding ActiveDocument.ZoomInCommand}"
                        Tag="{x:Static res:Icons.ZoomIn}"
                        ToolTip.Tip="拡大 (Ctrl++)" />

                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />

                <!--
                    ビューアの開閉。入っているかどうかを見せたいのでボタンではなく入切にする。
                -->
                <ToggleButton Theme="{StaticResource ToolBarToggleButton}"
                              IsChecked="{Binding Viewer.IsVisible, Mode=TwoWay}"
                              Tag="{x:Static res:Icons.Viewer}"
                              ToolTip.Tip="ビューア (F7)" />

                <!--
                    設定。ツールバーのいちばん右に置く。ここだけはマップの操作ではなく
                    アプリ全体の話なので、他と離して末尾に固定する。
                -->
                <Border Width="1" Margin="5,4" Background="{StaticResource DividerBrush}" />
                <Button Theme="{StaticResource ToolBarButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Tag="{x:Static res:Icons.Settings}"
                        ToolTip.Tip="設定" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#FAFBFC"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#666"
                           VerticalAlignment="Center"
                           Text="ドラッグで移動 / ダブルクリックで編集 / Ctrl+クリックや余白のドラッグで複数選択 / Ctrl+Enter で確定 / Ctrl+ホイールで拡大縮小" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <TextBlock Foreground="#666"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveDocument.SelectedNodes.Count, StringFormat={}{0} 個選択}" />
                    <TextBlock Foreground="#666"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveDocument.Zoom, StringFormat={}{0:P0}}" />
                    <TextBlock Foreground="#666"
                               VerticalAlignment="Center"
                               Text="{Binding ActiveDocument.CurrentFilePath, TargetNullValue=未保存}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ビューア。選択中のノードの本文か、リンク先のファイルを右側に出す。
            間の細い帯はドラッグで幅を変えるためのもので、たたんでいる間は帯ごと消す。
            DockPanel は先に置いたものから外側に付くので、ビューア・帯・タブの順に並べる。
        -->
        <views:ViewerPane DockPanel.Dock="Right"
                          DataContext="{Binding Viewer}"
                          Width="{Binding Width}"
                          IsVisible="{Binding IsVisible}" />

        <Border DockPanel.Dock="Right"
                Width="6"
                Background="Transparent"
                Cursor="SizeWestEast"
                IsVisible="{Binding Viewer.IsVisible}"
                PointerPressed="ViewerSplitter_PointerPressed"
                PointerMoved="ViewerSplitter_PointerMoved"
                PointerReleased="ViewerSplitter_PointerReleased" />

        <TabControl ItemsSource="{Binding Documents}"
                    SelectedItem="{Binding ActiveDocument}"
                    Padding="0">

            <!-- タブの見出し。ファイル名と、閉じるための × ボタン。 -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:DocumentViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        <!-- ウィンドウの ViewModel へは型変換を書かずに辿る。
                             ((vm:MainWindowViewModel)DataContext) と書くと、実行時に型を解決できず
                             起動した直後に落ちていた（このバインドはコンパイルされないため）。 -->
                        <Button Theme="{StaticResource TabCloseButton}"
                                ToolTip.Tip="このタブを閉じる (Ctrl+W)"
                                Command="{Binding $parent[Window].DataContext.CloseDocumentCommand}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- タブの中身。ドキュメントごとに同じキャンバスを描く。 -->
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:DocumentViewModel">
                    <ScrollViewer Name="Scroller"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource CanvasBrush}"
                                  DataContextChanged="Scroller_DataContextChanged"
                                  ScrollChanged="Scroller_ScrollChanged"
                                  PointerWheelChanged="Scroller_PointerWheelChanged"
                                  PointerPressed="Scroller_PointerPressed"
                                  PointerMoved="Scroller_PointerMoved"
                                  PointerReleased="Scroller_PointerReleased">

                        <!-- キャンバスは固定サイズ。スクロールで広い領域を使う。
                             拡大縮小は LayoutTransformControl で行う（描画だけの変形だと
                             スクロールできる範囲が拡大率に追従しない）。 -->
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            </LayoutTransformControl.LayoutTransform>

                            <Panel Name="CanvasRoot"
                                   DragDrop.AllowDrop="True"
                                   Width="3000"
                                   Height="2000"
                                   Background="Transparent"
                                   PointerPressed="CanvasRoot_PointerPressed"
                                   PointerMoved="CanvasRoot_PointerMoved"
                                   PointerReleased="CanvasRoot_PointerReleased">

                                <!-- 接続線はノードより下に描く -->
                                <ItemsControl ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ConnectionViewModel">
                                            <Line Stroke="{StaticResource LineBrush}"
                                                  StrokeThickness="2"
                                                  IsVisible="{Binding IsVisible}">
                                                <Line.StartPoint>
                                                    <MultiBinding Converter="{x:Static conv:AppConverters.ToPoint}">
                                                        <Binding Path="X1" />
                                                        <Binding Path="Y1" />
                                                    </MultiBinding>
                                                </Line.StartPoint>
                                                <Line.EndPoint>
                                                    <MultiBinding Converter="{x:Static conv:AppConverters.ToPoint}">
                                                        <Binding Path="X2" />
                                                        <Binding Path="Y2" />
                                                    </MultiBinding>
                                                </Line.EndPoint>
                                            </Line>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Styles>
                                        <!-- 位置はノードが持っている。選択中のものは重なり順を上げ、
                                             他のノードに隠れないようにする。 -->
                                        <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:NodeViewModel">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            <Setter Property="ZIndex"
                                                    Value="{Binding IsSelected, Converter={x:Static conv:AppConverters.SelectedZIndex}}" />
                                            <!-- 畳んだ祖先がいるノードは消す。一覧から外さず見せないだけにして、
                                                 開いたときに位置も親子関係も元どおりに戻るようにしてある。 -->
                                            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:NodeViewModel">
                                            <!-- 幅・高さは指定せず中身に合わせる。MaxWidth を超えたぶんは折り返す。
                                                 倍率は RenderTransform で掛ける。LayoutTransform だと測り直しが起きて、
                                                 Node_SizeChanged が返す実測サイズに倍率が二重に掛かる。
                                                 原点は左上に固定してあるので、画面上の矩形は
                                                 (X, Y, WorldWidth, WorldHeight) と一致する。 -->
                                            <Border Classes="node"
                                                    DragDrop.AllowDrop="True"
                                                    RenderTransformOrigin="0%,0%"
                                                    MinWidth="120"
                                                    MaxWidth="320"
                                                    MinHeight="48"
                                                    CornerRadius="8"
                                                    Background="White"
                                                    Cursor="SizeAll"
                                                    Classes.selected="{Binding IsSelected}"
                                                    SizeChanged="Node_SizeChanged"
                                                    PointerPressed="Node_PointerPressed"
                                                    PointerMoved="Node_PointerMoved"
                                                    PointerReleased="Node_PointerReleased">
                                                <Border.RenderTransform>
                                                    <MultiBinding Converter="{x:Static conv:AppConverters.WorldScale}">
                                                        <Binding Path="WorldScaleX" />
                                                        <Binding Path="WorldScaleY" />
                                                    </MultiBinding>
                                                </Border.RenderTransform>
                                                <Border.Styles>
                                                    <!-- 枠の色はスタイルで決める。Border に直接書くと、その値がスタイルより
                                                         優先されて、選んでも色が変わらなかった。 -->
                                                    <Style Selector="Border.node">
                                                        <Setter Property="BorderBrush" Value="{StaticResource NodeBorderBrush}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                    <Style Selector="Border.node.selected">
                                                        <Setter Property="BorderBrush" Value="{StaticResource LinkBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Style>
                                                </Border.Styles>

                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="切り取り" InputGesture="Ctrl+X" Click="ContextCut_Click" />
                                                        <MenuItem Header="コピー" InputGesture="Ctrl+C" Click="ContextCopy_Click" />
                                                        <MenuItem Header="貼り付け（この下に）" InputGesture="Ctrl+V" Click="ContextPaste_Click" />
                                                        <Separator />
                                                        <MenuItem Header="子ノードを別のファイルに保存..."
                                                                  IsEnabled="{Binding HasChildren}"
                                                                  Click="ContextExtractChildren_Click" />
                                                        <Separator />
                                                        <MenuItem Header="リンクを開く"
                                                                  IsEnabled="{Binding HasLink}"
                                                                  Click="ContextOpenLink_Click" />
                                                        <Separator />
                                                        <MenuItem Header="ファイルを選んでリンク..." Click="ContextSetFileLink_Click" />
                                                        <MenuItem Header="リンクを削除"
                                                                  IsEnabled="{Binding HasLink}"
                                                                  Click="ContextRemoveLink_Click" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>

                                                <Panel Margin="12,8">
                                                    <!-- 表示：タイトルは中央、内容は左寄せ。内容が空なら区切り線ごと省く。 -->
                                                    <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsEditing}">
                                                        <!-- タイトルの右に、リンクアイコンと表示の大小を切り替えるアイコンが並ぶ。
                                                             どちらも出ないときは右の 2 列が幅 0 になり、タイトルは中央のままになる。 -->
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Theme="{StaticResource NodeLinkButton}"
                                                                    IsVisible="{Binding HasLink}"
                                                                    ToolTip.Tip="{Binding Link}"
                                                                    Click="NodeLink_Click" />
                                                            <!-- 本文があるノードだけ、大小を切り替えるボタンを出す。 -->
                                                            <Button Grid.Column="2"
                                                                    Margin="2,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Theme="{StaticResource NodeToggleButton}"
                                                                    IsVisible="{Binding HasBodyContent}"
                                                                    ToolTip.Tip="表示の大小を切り替え（タイトルのみ／本文つき）"
                                                                    Click="NodeToggle_Click" />
                                                            <!-- 子がいるノードだけ、その先を畳むボタンを出す。 -->
                                                            <Button Grid.Column="3"
                                                                    Margin="2,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Theme="{StaticResource NodeChildrenToggleButton}"
                                                                    IsVisible="{Binding HasChildren}"
                                                                    ToolTip.Tip="子ノードの表示を切り替え"
                                                                    Click="NodeChildren_Click" />
                                                        </Grid>
                                                        <Border Height="1"
                                                                Margin="0,6"
                                                                Background="{StaticResource DividerBrush}"
                                                                IsVisible="{Binding IsBodyVisible}" />
                                                        <!--
                                                            本文欄。リンク先が画像や動画なら、文章の代わりに絵を出す
                                                            （パッケージが絵を作れたときだけ Thumbnail に入る）。
                                                            出す・出さないの切り替えは文章のときと同じ IsBodyVisible。
                                                        -->
                                                        <TextBlock Text="{Binding Body}"
                                                                   TextAlignment="Left"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource BodyBrush}">
                                                            <TextBlock.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="IsBodyVisible" />
                                                                    <Binding Path="!HasThumbnail" />
                                                                </MultiBinding>
                                                            </TextBlock.IsVisible>
                                                        </TextBlock>
                                                        <!--
                                                            絵の下地。256 角の白い枠に、縦横比を保ったまま中央に収める
                                                            （Uniform が縦横比を保ち、余ったぶんが白く残る）。
                                                        -->
                                                        <Border Width="256"
                                                                Height="256"
                                                                Background="White"
                                                                BorderBrush="{StaticResource DividerBrush}"
                                                                BorderThickness="1">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="IsBodyVisible" />
                                                                    <Binding Path="HasThumbnail" />
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform"
                                                                   StretchDirection="DownOnly"
                                                                   RenderOptions.BitmapInterpolationMode="HighQuality"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- 編集：タイトル欄は 1 行のみ。Enter で内容欄に移る。
                                                         フォーカスが 2 つの欄の間を移る間は編集を続け、外に出たら確定する。 -->
                                                    <StackPanel IsVisible="{Binding IsEditing}" LostFocus="EditPanel_LostFocus">
                                                        <TextBox Text="{Binding Title}"
                                                                 MinWidth="96"
                                                                 AcceptsReturn="False"
                                                                 TextAlignment="Center"
                                                                 FontWeight="SemiBold"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="0"
                                                                 AttachedToVisualTree="TitleBox_AttachedToVisualTree"
                                                                 ContextFlyout="{StaticResource EditBoxMenu}"
                                                                 KeyDown="EditBox_KeyDown" />
                                                        <Border Height="1" Margin="0,6" Background="{StaticResource DividerBrush}" />
                                                        <TextBox Text="{Binding Body}"
                                                                 MinWidth="96"
                                                                 MinHeight="32"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 TextAlignment="Left"
                                                                 FontSize="12"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 Padding="0"
                                                                 ContextFlyout="{StaticResource EditBoxMenu}"
                                                                 KeyDown="EditBox_KeyDown" />

                                                        <!-- リンク欄。本文から Tab で移れる。 -->
                                                        <Border Height="1" Margin="0,6" Background="{StaticResource DividerBrush}" />
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Path Data="{x:Static res:Icons.Link}"
                                                                  Width="11"
                                                                  Height="11"
                                                                  Margin="0,0,5,0"
                                                                  Stretch="Uniform"
                                                                  Stroke="{StaticResource MutedBrush}"
                                                                  StrokeThickness="1.7"
                                                                  StrokeJoin="Round"
                                                                  StrokeLineCap="Round"
                                                                  VerticalAlignment="Center" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Link}"
                                                                     MinWidth="96"
                                                                     FontSize="11"
                                                                     Foreground="{StaticResource BodyBrush}"
                                                                     BorderThickness="0"
                                                                     Background="Transparent"
                                                                     Padding="0"
                                                                     Watermark="URL やファイルのパス"
                                                                     ContextFlyout="{StaticResource EditBoxMenu}"
                                                                 KeyDown="EditBox_KeyDown" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Panel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 範囲選択の枠。余白をドラッグしている間だけ出す。
                                     ノードのクリックを邪魔しないよう、当たり判定は持たせない。 -->
                                <Canvas IsHitTestVisible="False">
                                    <Rectangle Name="SelectionBox"
                                               IsVisible="False"
                                               Fill="#282F80ED"
                                               Stroke="{StaticResource LinkBrush}"
                                               StrokeThickness="1" />
                                </Canvas>
                            </Panel>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
